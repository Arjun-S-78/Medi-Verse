# MediVerse Enterprise Backend Environment Configuration Template
# Copy this file to .env or export variables in production

# Application Server
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mediverse_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_password

# Security & JWT Configuration
JWT_SECRET=YOUR_JWT_SECRET_KEY
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=mediverse-health-security

# Third-Party Integrations
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json
